<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <ReportParameters><ReportParameter Name="ParentTitle" /></ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body><ReportItems>
        <Subreport Name="ChildReport">
          <ReportName>Child</ReportName><Left>1cm</Left><Top>1cm</Top>
          <Parameters><Parameter Name="ChildTitle"><Value>=Parameters!ParentTitle.Value</Value></Parameter></Parameters>
        </Subreport>
      </ReportItems></Body>
      <PageWidth>21cm</PageWidth><PageHeight>29.7cm</PageHeight>
    </ReportSection>
  </ReportSections>
</Report>
