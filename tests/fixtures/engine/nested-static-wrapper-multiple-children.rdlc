                    <TablixMember><Group Name="ProductGroup"><GroupExpressions><GroupExpression>=Fields!Product.Value</GroupExpression></GroupExpressions></Group></TablixMember>
                    <TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixMember>
          </TablixMembers>
        </TablixMember>
        <TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember>
      </TablixMembers></TablixRowHierarchy>
      <DataSetName>Items</DataSetName>
    </Tablix></ReportItems></Body>
