<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSets><DataSet Name="Items"><Fields><Field Name="Category"><DataField>Category</DataField></Field><Field Name="Region"><DataField>Region</DataField></Field><Field Name="Product"><DataField>Product</DataField></Field><Field Name="Name"><DataField>Name</DataField></Field></Fields></DataSet></DataSets>
  <ReportSections><ReportSection>
    <Body><ReportItems><Tablix Name="Items">
      <TablixBody><TablixColumns><TablixColumn><Width>12cm</Width></TablixColumn></TablixColumns><TablixRows>
        <TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox><TextRuns><TextRun><Value>Nested multi-child wrapper</Value></TextRun></TextRuns></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
        <TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox><TextRuns><TextRun><Value>="Category: " &amp; Fields!Category.Value</Value></TextRun></TextRuns></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
