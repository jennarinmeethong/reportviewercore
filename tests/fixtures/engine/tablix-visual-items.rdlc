<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <DataSets>
    <DataSet Name="Items">
      <Fields><Field Name="Name"><DataField>Name</DataField></Field><Field Name="Amount"><DataField>Amount</DataField></Field></Fields>
    </DataSet>
  </DataSets>
  <ReportSections><ReportSection>
    <Body><ReportItems><Tablix Name="VisualItems">
      <TablixBody>
        <TablixColumns><TablixColumn><Width>12cm</Width></TablixColumn></TablixColumns>
        <TablixRows>
          <TablixRow><Height>0.7cm</Height><TablixCells><TablixCell><CellContents><Textbox><TextRuns><TextRun><Value>Cell visuals</Value></TextRun></TextRuns></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>8cm</Height><TablixCells><TablixCell><CellContents>
            <Rectangle Name="CellFrame"><Left>0.2cm</Left><Top>0.2cm</Top><Width>4cm</Width><Height>2cm</Height><Style><BackgroundColor>#E6EEF8</BackgroundColor><BorderColor>blue</BorderColor></Style></Rectangle>
            <Line Name="CellRule"><Left>0.2cm</Left><Top>2.5cm</Top><Width>4cm</Width><Height>0cm</Height><Style><BorderColor>red</BorderColor></Style></Line>
            <Chart Name="CellChart"><Title>Sales in cell</Title><DataSetName>Items</DataSetName><CategoryExpression>=Fields!Name.Value</CategoryExpression><ValueExpression>=Fields!Amount.Value</ValueExpression><Left>0.5cm</Left><Top>3cm</Top><Width>8cm</Width><Height>4cm</Height></Chart>
          </CellContents></TablixCell></TablixCells></TablixRow>
        </TablixRows>
      </TablixBody>
      <DataSetName>Items</DataSetName>
    </Tablix></ReportItems></Body>
    <PageWidth>21cm</PageWidth><PageHeight>29.7cm</PageHeight>
  </ReportSection></ReportSections>
</Report>
