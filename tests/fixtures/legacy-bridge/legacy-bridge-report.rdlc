<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="LocalSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Items">
      <Query>
        <DataSourceName>LocalSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="Description"><DataField>Description</DataField></Field>
        <Field Name="Price"><DataField>Price</DataField></Field>
        <Field Name="Qty"><DataField>Qty</DataField></Field>
        <Field Name="Total"><DataField>Total</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Width>6.5in</Width>
  <Body>
    <ReportItems>
      <Textbox Name="BridgeTitle">
        <CanGrow>true</CanGrow>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Windows bridge</Value></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0in</Top><Left>0in</Left><Height>0.3in</Height><Width>4in</Width>
      </Textbox>
      <Textbox Name="BridgeBackend">
        <CanGrow>true</CanGrow>
        <Paragraphs><Paragraph><TextRuns><TextRun><Value>Shared Skia backend</Value></TextRun></TextRuns></Paragraph></Paragraphs>
        <Top>0.4in</Top><Left>0in</Left><Height>0.3in</Height><Width>4in</Width>
      </Textbox>
    </ReportItems>
    <Height>1in</Height>
  </Body>
  <Page>
    <PageHeight>11in</PageHeight><PageWidth>8.5in</PageWidth>
    <LeftMargin>1in</LeftMargin><RightMargin>1in</RightMargin>
    <TopMargin>1in</TopMargin><BottomMargin>1in</BottomMargin>
  </Page>
</Report>
