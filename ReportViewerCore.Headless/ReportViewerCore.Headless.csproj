<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ReportViewerCore.Headless</AssemblyName>
    <RootNamespace>ReportViewerCore.Headless</RootNamespace>
    <PackageId>ReportViewerCore.Headless</PackageId>
    <VersionPrefix>2.0.0-preview.1</VersionPrefix>
    <Description>Headless LocalReport and ServerReport workflows for cross-platform rendering.</Description>
    <PackageTags>reportviewer;rdlc;headless;ssrs;cross-platform</PackageTags>
    <RepositoryUrl>https://github.com/jennarinmeethong/reportviewercore</RepositoryUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReportViewerCore.Engine\ReportViewerCore.Engine.csproj" />
    <ProjectReference Include="..\ReportViewerCore.Rendering.Abstractions\ReportViewerCore.Rendering.Abstractions.csproj" />
  </ItemGroup>
</Project>
